FROM node:24-alpine

ARG USER_ID=1000
ARG GROUP_ID=1000

RUN deluser --remove-home node \
    && addgroup -S -g "${GROUP_ID}" node \
    && adduser -D -u "${USER_ID}" -G node \
        -h /home/node -s /bin/sh node \
    && mkdir -p /app \
    && chown -R node:node /app /home/node

RUN npm install --global pnpm@12.11.2

WORKDIR /app

COPY --chown=node:node . .

USER node

EXPOSE 3000

RUN pnpm install --frozen-lockfile

CMD ["pnpm", "run", "dev"]
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/dist",
      "!!**/out",
      "!!**/build",
      "!!**/public",
      "!**/*.min.js",
      "!**/index.html",
      "!**/package-lock.json",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 150,
    "lineEnding": "auto",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "attributePosition": "multiline"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "next": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "off"
      },
      "style": {
        "useBlockStatements": "warn",
        "noUselessElse": "warn"
      },
      "suspicious": {
        "noConsole": "off",
        "noDoubleEquals": "warn",
        "noIrregularWhitespace": "off",
        "noExplicitAny": "off",
        "noUnusedExpressions": "off",
        "noDuplicateObjectKeys": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}

{
  "name": "next-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "tsc": "tsc --noEmit",
    "lint.eslint": "eslint . --ext .ts,.tsx,.mts,cts,.js,.mjs,.cjs,.json --cache",
    "lint.prettier": "eslint . --ext .ts,.tsx,.mts,cts,.js,.mjs,.cjs,.json --cache",
    "lint": "npm run lint.eslint && npm run lint.prettier",
    "format": "npm run lint.eslint --fix && npm run lint.prettier --write",
    "build": "npm run tsc && npm run lint && next build",
    "start": "next start"
  },
  "devDependencies": {
    "@eslint/json": "^2.1.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}

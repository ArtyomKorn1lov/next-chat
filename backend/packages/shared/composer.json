{
  "name": "package/shared",
  "description": "Shared module for Laravel app",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Package\\Shared\\": "src/",
      "Package\\Shared\\Database\\Factories\\": "database/factories/",
      "Package\\Shared\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "minimum-stability": "stable",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^13.0",
    "laravel/framework": "^13.17",
    "laravel/tinker": "^3.0",
    "spatie/laravel-package-tools": "^1.93"
  }
}

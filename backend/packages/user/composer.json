{
  "name": "package/user",
  "description": "User module for Laravel app",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Package\\User\\": "src/",
      "Package\\User\\Database\\Factories\\": "database/factories/",
      "Package\\User\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "minimum-stability": "stable",
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "laravel": {
      "providers": ["Package\\User\\UserServiceProvider"]
    }
  },
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "spatie/laravel-package-tools": "^1.93",
    "package/shared": "*@dev"
  }
}

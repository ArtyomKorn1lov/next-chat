{
  "name": "package/chat",
  "description": "Chat module for Laravel app",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Package\\Chat\\": "src/",
      "Package\\Chat\\Database\\Factories\\": "database/factories/",
      "Package\\Chat\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "minimum-stability": "stable",
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^13.0",
    "laravel/framework": "^13.17",
    "laravel/tinker": "^3.0",
    "spatie/laravel-package-tools": "^1.93",
    "package/shared": "*@dev"
  }
}
